# ============================================================
# Nutrition Agent — Environment Variables
# ============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your own values below.
# 3. Never commit your .env file to version control.
# ============================================================

# Required — IBM Cloud API key
# Get yours at: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_ibm_cloud_api_key_here

# Required — watsonx project ID
# Find it in your watsonx.ai project settings
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# Optional — watsonx generation endpoint (default shown below)
WATSONX_URL=https://us-south.ml.cloud.ibm.com/ml/v1/text/generation?version=2023-05-29

# Optional — Granite model ID (default shown below)
MODEL_ID=ibm/granite-4-h-small
